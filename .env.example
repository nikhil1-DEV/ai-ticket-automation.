# Database (use SQLite for local dev, PostgreSQL for Docker)
DATABASE_URL=sqlite:///./tickets.db
# DATABASE_URL=postgresql://admin:admin123@localhost:5432/ticket_automation

# AI Provider: "auto", "gemini", "openai", or "fallback"
AI_PROVIDER=auto

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Webhook URL for outgoing notifications (optional)
WEBHOOK_URL=

# App Settings
APP_NAME=AI Ticket Automation
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
